{
    "headers": [
        {
            "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, stale-while-revalidate=86400"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "assef-e-moschetta-advogados.falarcomadvogado.com.br"
                }
            ],
            "destination": "/empresas",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/_next/:path*",
            "destination": "https://chat-funnel-alpha.vercel.app/_next/:path*"
        },
        {
            "source": "/chat",
            "has": [
                {
                    "type": "host",
                    "value": "(?<subdomain>[^.]+)\\.falarcomadvogado\\.com\\.br"
                }
            ],
            "destination": "https://chat-funnel-alpha.vercel.app/:subdomain"
        },
        {
            "source": "/chat/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "(?<subdomain>[^.]+)\\.falarcomadvogado\\.com\\.br"
                }
            ],
            "destination": "https://chat-funnel-alpha.vercel.app/:subdomain/:path*"
        },
        {
            "source": "/privacidade",
            "destination": "/_compartilhado/privacidade.html"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "(?<subdomain>[^.]+)\\.falarcomadvogado\\.com\\.br"
                }
            ],
            "destination": "/:subdomain/index.html"
        },
        {
            "source": "/:file((?!chat|_next).*)",
            "has": [
                {
                    "type": "host",
                    "value": "(?<subdomain>[^.]+)\\.falarcomadvogado\\.com\\.br"
                }
            ],
            "destination": "/:subdomain/:file"
        }
    ]
}